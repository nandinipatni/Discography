# apps/api — environment variables
# Copy this file to .env and fill in your values

NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/discography?schema=public

# JWT — must be at least 32 characters in production
JWT_SECRET=change_me_to_a_long_random_string_min_32_chars
JWT_EXPIRES_IN=7d

# CORS origin for the web frontend
CORS_ORIGIN=http://localhost:5173
