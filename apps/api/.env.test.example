# apps/api — test environment variables
# Copy this file to .env.test and fill in your values
# Uses a SEPARATE test database to keep production data safe

NODE_ENV=test
PORT=3002
HOST=0.0.0.0

# Point at your test database (must be created separately)
# e.g. createdb discography_test && npx prisma migrate deploy
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/discography_test?schema=public

# JWT — any string is fine for tests
JWT_SECRET=test_secret_thats_long_enough_for_hs256
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173
